import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.naive_bayes import MultinomialNB
from sklearn.linear_model import LogisticRegression
from sklearn.svm import SVC
from sklearn.metrics import classification_report, accuracy_score, confusion_matrix

# Sample SMS dataset 
data = {
    'message': [
        'Free entry in 2 a wkly comp to win FA Cup final tkts', 'Go until jurong point', 
        'WINNER!! As a valued customer, you have been selected', 'How are you doing today?',
        'Call me when you get this', 'Congratulations! You won $1000 cash prize',
        'Can we meet for lunch tomorrow?', 'URGENT! You have won a 1 week FREE membership',
        'Thanks for your yesterday kiss', 'XXXMobileMovieClub: To use your credit',
        'I miss you so much', 'FREE for 1st week! No1 Nokia tone'
    ],
    'label': ['spam', 'ham', 'spam', 'ham', 'ham', 'spam', 'ham', 'spam', 'ham', 'spam', 'ham', 'spam']
}

# Create DataFrame and preprocess
df = pd.DataFrame(data)
df['label'] = df['label'].map({'spam': 1, 'ham': 0})  # Convert labels to binary

# Split dataset into training and testing sets
X_train, X_test, y_train, y_test = train_test_split(
    df['message'], df['label'], test_size=0.3, random_state=42
)

# Feature extraction using TF-IDF (Term Frequency-Inverse Document Frequency)
vectorizer = TfidfVectorizer(stop_words='english', max_features=100)
X_train_tfidf = vectorizer.fit_transform(X_train)
X_test_tfidf = vectorizer.transform(X_test)

# Train multiple classifiers
models = {
    'Naive Bayes': MultinomialNB(),
    'Logistic Regression': LogisticRegression(max_iter=200),
    'SVM': SVC(kernel='linear')
}

print("SMS Spam Classification Results\n" + "="*50)

# Train and evaluate each model
for name, model in models.items():
    model.fit(X_train_tfidf, y_train)
    y_pred = model.predict(X_test_tfidf)
    accuracy = accuracy_score(y_test, y_pred)
    print(f"\n{name}:")
    print(f"Accuracy: {accuracy:.2%}")
    print(classification_report(y_test, y_pred, target_names=['Ham', 'Spam']))

# Demonstrate prediction on new messages
best_model = models['Logistic Regression']  # Often performs well
test_messages = [
    "Congratulations! You've won a free iPhone. Click here now!",
    "Hey, are you free for coffee tomorrow?"
]

print("\n" + "="*50 + "\nPredictions on New Messages:\n")
for msg in test_messages:
    vec = vectorizer.transform([msg])
    pred = best_model.predict(vec)[0]
    label = 'SPAM' if pred == 1 else 'HAM'
    print(f"Message: {msg}\nPrediction: {label}\n")
